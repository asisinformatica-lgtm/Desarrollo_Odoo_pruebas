<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_tire_service_line_wizard_form" model="ir.ui.view">
        <field name="name">fleet.maintenance.tire.service.line.wizard.form</field>
        <field name="model">fleet.maintenance.tire.service.line.wizard</field>
        <field name="arch" type="xml">

            <form string="Crear Líneas de Reparación" class="o_form_full">

                <sheet>

                    <!-- UNIDAD -->
                    <group>
                        <field name="unit_type" widget="radio"/>
                    </group>

                    <group col="2">

                        <!-- IMAGEN GRANDE Y CENTRADA -->
                        <group>
                            <div style="display:flex; justify-content:center; padding:20px;">
                                <field name="unit_image"
                                       widget="image"
                                       nolabel="1"
                                       style="max-width:520px; max-height:280px;"/>
                            </div>
                        </group>

                        <!-- CAMPOS -->
                        <group>
                            <field name="mechanic_id"/>

                            <!-- ✅ POSICIONES MULTI-SELECCIÓN -->
                            <field name="position_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"/>

                            <field name="size"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="change_date"/>
                            <field name="wear_type"/>
                            <field name="supplier_id"/>
                            <field name="invoice"/>
                            <field name="price"/>
                        </group>

                    </group>

                </sheet>

                <footer>
                    <button name="action_create_lines"
                            type="object"
                            string="Guardar y cerrar"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>

        </field>
    </record>

</odoo>
