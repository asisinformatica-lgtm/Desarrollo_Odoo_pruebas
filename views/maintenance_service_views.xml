<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Acción -->
    <record id="fleet_maintenance_tire_service_action" model="ir.actions.act_window">
        <field name="name">Servicios de Llantas</field>
        <field name="res_model">fleet.maintenance.tire.service</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Vista lista -->
    <record id="fleet_maintenance_tire_service_list" model="ir.ui.view">
        <field name="name">fleet.maintenance.tire.service.list</field>
        <field name="model">fleet.maintenance.tire.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="amount_total"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario -->
    <record id="fleet_maintenance_tire_service_form" model="ir.ui.view">
        <field name="name">fleet.maintenance.tire.service.form</field>
        <field name="model">fleet.maintenance.tire.service</field>
        <field name="arch" type="xml">

            <form string="Servicio de Llantas">

                <header>
                    <button name="action_confirm"
                            type="object"
                            string="Confirmar"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_done"
                            type="object"
                            string="Finalizar"
                            invisible="state != 'confirmed'"/>

                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <field name="name" readonly="state != 'draft'"/>
                        <field name="vehicle_id" readonly="state != 'draft'"/>
                        <field name="date" readonly="state != 'draft'"/>
                    </group>

                    <notebook>
                        <page string="Detalle">

                            <!-- Botón Wizard -->
                            <button name="%(fleet_maintenance_extended.action_open_tire_service_line_wizard)d"
                                    type="action"
                                    string="Agregar línea"
                                    class="btn-primary"
                                    invisible="state != 'draft'"/>

                            <!-- Líneas técnicas de llantas -->
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="description" string="posición"/>
                                    <field name="brand"/>
                                    <field name="model"/>
                                    <field name="size"/>
                                    <field name="wear_type"/>
                                    <field name="price"/>
                                </list>
                            </field>

                        </page>
                    </notebook>

                    <group class="oe_subtotal_footer">
                        <field name="amount_total"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

</odoo>
