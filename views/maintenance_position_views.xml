<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================= -->
    <!-- VISTA LISTA (FASE 15.4) -->
    <!-- ========================= -->
    <record id="fleet_maintenance_tire_position_list" model="ir.ui.view">
        <field name="name">fleet.maintenance.tire.position.list</field>
        <field name="model">fleet.maintenance.tire.position</field>
        <field name="arch" type="xml">
            <list
                decoration-success="alert_level == 'ok'"
                decoration-warning="alert_level == 'warning'"
                decoration-danger="alert_level == 'danger'"
            >
                <field name="name"/>
                <field name="service_count"/>
                <field name="last_change_date"/>
                <field name="total_cost"/>
                <field name="alert_level" widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ========================= -->
    <!-- VISTA FORMULARIO -->
    <!-- ========================= -->
    <record id="fleet_maintenance_tire_position_form" model="ir.ui.view">
        <field name="name">fleet.maintenance.tire.position.form</field>
        <field name="model">fleet.maintenance.tire.position</field>
        <field name="arch" type="xml">
            <form string="Posición de Llanta">

                <header>
                    <field name="alert_level"
                           widget="statusbar"
                           statusbar_visible="ok,warning,danger"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="alert_level" widget="badge"/>
                    </group>

                    <group>
                        <field name="service_count" readonly="1"/>
                        <field name="last_change_date" readonly="1"/>
                        <field name="total_cost" readonly="1"/>
                        <field name="active"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- ========================= -->
    <!-- ACCIÓN -->
    <!-- ========================= -->
    <record id="fleet_maintenance_tire_position_action" model="ir.actions.act_window">
        <field name="name">Posiciones de Llantas</field>
        <field name="res_model">fleet.maintenance.tire.position</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
