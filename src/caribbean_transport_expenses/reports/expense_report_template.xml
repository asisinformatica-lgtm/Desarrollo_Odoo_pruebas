<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="expense_report_template">

        <t t-call="web.external_layout">

            <main>

                <t t-foreach="docs" t-as="doc">

                    <div class="page">

                        <!-- ENCABEZADO CORPORATIVO -->

                        <table style="width:100%; margin-bottom:10px;">
                            <tr>
                                <td style="width:30%;">
                                    <img t-if="doc.company_id.logo"
                                         t-att-src="'data:image/png;base64,%s' % doc.company_id.logo"
                                         style="max-height:80px;"/>
                                </td>

                                <td style="width:70%; text-align:right; font-size:12px;">
                                    <strong>Grupo Caribbean Port S.A.</strong><br/>
                                    3ra. calle, Colonia Piedras Negras, calle al bordo,<br/>
                                    Santo Tomas De Castilla<br/>
                                    Puerto Barrios, Izabal, Guatemala
                                </td>
                            </tr>
                        </table>

                        <hr/>

                        <h2 style="text-align:center;">
                            REPORTE DE GASTO
                        </h2>

                        <p style="text-align:center; font-size:12px;">
                            Documento interno de gasto
                        </p>

                        <br/>

                        <!-- INFORMACIÓN DEL GASTO -->

                        <table style="width:100%; border-collapse:collapse; margin-bottom:20px;">
                            <tr style="background:#e6e6e6;">
                                <th colspan="4" style="border:1px solid #000; padding:6px; text-align:left;">
                                    Información del gasto
                                </th>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:6px;"><strong>Correlativo</strong></td>
                                <td style="border:1px solid #000; padding:6px;">
                                    <t t-esc="doc.expense_sequence"/>
                                </td>

                                <td style="border:1px solid #000; padding:6px;"><strong>Fecha</strong></td>
                                <td style="border:1px solid #000; padding:6px;">
                                    <t t-esc="doc.date"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:6px;"><strong>Empleado</strong></td>
                                <td style="border:1px solid #000; padding:6px;">
                                    <t t-esc="doc.employee_id.name"/>
                                </td>

                                <td style="border:1px solid #000; padding:6px;"><strong>Categoría</strong></td>
                                <td style="border:1px solid #000; padding:6px;">
                                    <t t-esc="dict(doc._fields['expense_category'].selection).get(doc.expense_category)"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:6px;"><strong>Descripción</strong></td>
                                <td colspan="3" style="border:1px solid #000; padding:6px;">
                                    <t t-esc="doc.name"/>
                                </td>
                            </tr>

                        </table>

                        <!-- TOTAL -->

                        <table style="width:100%; margin-top:20px;">
                            <tr>
                                <td style="width:70%;"></td>
                                <td style="width:30%; border:1px solid #000; padding:10px; text-align:right; font-size:15px;">
                                    <strong>Total del gasto:</strong><br/>
                                    <span t-esc="doc.total_amount"
                                          t-options='{"widget":"monetary","display_currency":doc.currency_id}'/>
                                </td>
                            </tr>
                        </table>

                        <!-- FIRMAS -->

                        <br/><br/><br/>

                        <table style="width:100%; text-align:center;">
                            <tr>
                                <td style="width:50%;">
                                    ___________________________<br/>
                                    Firma del Empleado
                                </td>
                                <td style="width:50%;">
                                    ___________________________<br/>
                                    Autorizado por Gerencia
                                </td>
                            </tr>
                        </table>

                    </div>

                </t>

            </main>

        </t>

    </template>

</odoo>