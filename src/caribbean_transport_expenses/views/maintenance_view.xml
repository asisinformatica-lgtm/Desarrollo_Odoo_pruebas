<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================= -->
    <!-- FORM VIEW -->
    <!-- ========================= -->
    <record id="view_caribbean_fleet_maintenance_form" model="ir.ui.view">
        <field name="name">caribbean.fleet.maintenance.form</field>
        <field name="model">caribbean.fleet.maintenance</field>
        <field name="arch" type="xml">
            <form string="Mantenimiento de Flota">
                <sheet>
                    <group col="2">
                        <field name="name" readonly="1"/>
                        <field name="vehicle_id"/>
                        <field name="license_plate" readonly="1"/>
                        <field name="maintenance_date"/>
                        <field name="odometer"/>
                        <field name="maintenance_type"/>
                        <field name="responsible_id"/>
                        <field name="state" readonly="1"/>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================= -->
    <!-- LIST VIEW (ANTES TREE) -->
    <!-- ========================= -->
    <record id="view_caribbean_fleet_maintenance_list" model="ir.ui.view">
        <field name="name">caribbean.fleet.maintenance.list</field>
        <field name="model">caribbean.fleet.maintenance</field>
        <field name="arch" type="xml">
            <list>
                <field name="maintenance_date"/>
                <field name="vehicle_id"/>
                <field name="license_plate"/>
                <field name="odometer"/>
                <field name="maintenance_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ========================= -->
    <!-- ACTION -->
    <!-- ========================= -->
    <record id="action_caribbean_fleet_maintenance" model="ir.actions.act_window">
        <field name="name">Mantenimiento de Flota</field>
        <field name="res_model">caribbean.fleet.maintenance</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
