<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================= -->
    <!-- SOLICITANTE: SOLO VE SUS REQUISICIONES -->
    <!-- ================================================= -->
    <record id="rule_purchase_advance_requester_own" model="ir.rule">
        <field name="name">Requisiciones - Solo propias</field>
        <field name="model_id" ref="model_purchase_advance"/>
        <field name="domain_force">[('requester_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('purchase_advance.group_purchase_advance_requester'))]"/>
    </record>

    <!-- ================================================= -->
    <!-- APROBADOR / FINANZAS: VE TODAS -->
    <!-- ================================================= -->
    <record id="rule_purchase_advance_approver_all" model="ir.rule">
        <field name="name">Requisiciones - Aprobador ve todas</field>
        <field name="model_id" ref="model_purchase_advance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('purchase_advance.group_purchase_advance_approver'))]"/>
    </record>

    <!-- ================================================= -->
    <!-- CONTABILIDAD: VE TODAS -->
    <!-- ================================================= -->
    <record id="rule_purchase_advance_accounting_all" model="ir.rule">
        <field name="name">Requisiciones - Contabilidad ve todas</field>
        <field name="model_id" ref="model_purchase_advance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('purchase_advance.group_purchase_advance_accounting'))]"/>
    </record>

</odoo>
