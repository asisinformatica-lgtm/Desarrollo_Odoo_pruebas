<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================= -->
    <!-- CATEGORÍA -->
    <!-- ========================= -->
    <record id="module_category_purchase_advance" model="ir.module.category">
        <field name="name">Requisiciones</field>
        <field name="sequence">30</field>
    </record>

    <!-- ========================= -->
    <!-- GRUPOS -->
    <!-- ========================= -->

    <record id="group_purchase_advance_requester" model="res.groups">
        <field name="name">Requisiciones - Solicitante</field>
        <field name="category_id" ref="module_category_purchase_advance"/>
    </record>

    <record id="group_purchase_advance_approver" model="res.groups">
        <field name="name">Requisiciones - Aprobador</field>
        <field name="category_id" ref="module_category_purchase_advance"/>
    </record>

    <record id="group_purchase_advance_accounting" model="res.groups">
        <field name="name">Requisiciones - Contabilidad</field>
        <field name="category_id" ref="module_category_purchase_advance"/>
    </record>

    <record id="group_purchase_advance_admin" model="res.groups">
        <field name="name">Requisiciones - Administrador</field>
        <field name="category_id" ref="module_category_purchase_advance"/>
    </record>

</odoo>
